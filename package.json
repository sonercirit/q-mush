{
  "name": "q-mush",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "bun run repository-check && bun run format:check && bun run typecheck && bun run lint && bun run knip && bun run cpd",
    "cpd": "cpd .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate-database.ts",
    "dev": "bun run scripts/dev.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "bun run knip:production && bun run knip:test",
    "knip:production": "knip --production --config knip.production.config.ts",
    "knip:test": "knip --config knip.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "repository-check": "bun run scripts/repository-check.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "drizzle-orm": "^0.45.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "cpd": "^5.0.13",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "jiti": "^2.7.0",
    "knip": "^6.25.0",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
