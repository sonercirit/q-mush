{
  "minLines": 1,
  "minTokens": 20,
  "threshold": 0,
  "noTips": true,
  "ignorePattern": [
    "(?ms)^import\\s+.*?;",
    "(?s)/\\* cpd-ignore-start(?: -- [^*]+)? \\*/.*?/\\* cpd-ignore-end(?: -- [^*]+)? \\*/"
  ],
  "format": ["tsx"],
  "formatsExts": {
    "tsx": ["js", "jsx", "mjs", "cjs", "es", "es6", "ts", "tsx", "mts", "cts"]
  }
}
