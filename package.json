{
  "name": "q-mush",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "bun run file-length && bun run format:check && bun run typecheck && bun run lint && bun run knip && bun run cpd",
    "cpd": "cpd .",
    "file-length": "bun run scripts/check-file-length.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "cpd": "^5.0.13",
    "eslint": "^10.6.0",
    "jiti": "^2.7.0",
    "knip": "^6.25.0",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
