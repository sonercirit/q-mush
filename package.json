{
  "name": "q-mush",
  "module": "sync-engine/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "bun run --sequential --no-exit-on-error --filter '*' repository-check format:check typecheck lint knip cpd",
    "cpd": "cpd .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate-database.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:restart": "bun run scripts/restart-development-server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "bun run --sequential --no-exit-on-error --filter '*' knip:production knip:test",
    "knip:production": "knip --production --config knip.production.config.ts",
    "knip:test": "knip --config knip.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "repository-check": "bun run scripts/repository-check.ts",
    "test": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.2",
    "drizzle-orm": "^0.45.2",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.2",
    "vite": "8.1.3",
    "vite-plugin-solid": "2.11.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "cpd": "^5.0.13",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "happy-dom": "20.10.6",
    "jiti": "^2.7.0",
    "knip": "^6.25.0",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "4.1.10"
  }
}
