{
  "name": "q-mush",
  "module": "sync-engine/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "bun run --parallel --no-exit-on-error --filter '*' repository-check format:check typecheck lint knip cpd",
    "cpd": "bun run scripts/cpd.ts",
    "dependency-age": "bun run scripts/dependency-age-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate-database.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:restart": "bun run scripts/restart-development-server.ts",
    "dev:watch": "bun run scripts/dev.ts --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "bun run --parallel --no-exit-on-error --filter '*' knip:production knip:test",
    "knip:production": "knip --production --config knip.production.config.ts",
    "knip:test": "knip --config knip.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "repository-check": "bun run scripts/repository-check.ts",
    "test": "bun run test:unit && bun run test:browser",
    "test:browser": "bun run --no-orphans scripts/test-browser.ts",
    "test:unit": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "drizzle-orm": "^0.45.2",
    "solid-js": "1.9.15",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@typescript-eslint/typescript-estree": "8.68.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "4.1.10",
    "cpd": "5.0.16",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-solid": "0.16.0",
    "happy-dom": "20.11.6",
    "jiti": "^2.7.0",
    "knip": "6.32.2",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.10"
  }
}
